POSTGRES_DB=fluxrun
POSTGRES_USER=fluxrun
POSTGRES_PASSWORD=replace-with-a-long-local-password
REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=fluxrun-local
MINIO_ROOT_PASSWORD=replace-with-a-long-minio-password
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
LOCAL_ADMIN_EMAIL=owner@fluxrun.com
LOCAL_ADMIN_PASSWORD=replace-this-before-starting
CORS_ORIGINS=http://localhost:5173
ENCRYPTION_KEY=replace-with-generated-fernet-key
S3_BUCKET=fluxrun-artifacts
SIGNUP_ENABLED=true
